  { nome: 'Festa Exclusiva', tag: 'Experiência VIP', desc: 'Personalização 360°: identidade visual, gastronomia gourmet e atrações exclusivas. O projeto dos sonhos ganhando vida.', accent: '#a9802a', tint: '#fdf3da', popular: false, img: '/uploads/pimpao-festas-mascote-pimpao-playground-menina.webp', alt: 'Aniversariante com vestido temático ao lado do mascote Pimpão no playground' },
