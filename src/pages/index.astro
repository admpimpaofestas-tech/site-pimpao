];

const galeria = [
  { label: 'Mascote Pimpão', src: '/uploads/pimpao-festas-mascote-pimpao-com-aniversariante.webp', alt: 'Mascote Pimpão posando com aniversariante em festa infantil em Cachoeirinha' },
  { label: 'Recreação guiada', src: '/uploads/pimpao-festas-recreacao-guiada-brincadeira-criancas.webp', alt: 'Recreador conduzindo brincadeira com grupo de crianças' },
  { label: 'Camarim de pintura', src: '/uploads/pimpao-festas-camarim-pintura-facial-menino.webp', alt: 'Pintura facial artística em menino no camarim do Pimpão' },
  { label: 'Big Jump', src: '/uploads/pimpao-festas-big-jump-crianca-pulando.webp', alt: 'Criança saltando no Big Jump da casa de festas Pimpão' },
  { label: 'Brinquedão', src: '/uploads/pimpao-festas-brinquedao-piscina-de-bolinhas.webp', alt: 'Brinquedão com piscina de bolinhas no playground do Pimpão' },
  { label: 'Gincana', src: '/uploads/pimpao-festas-recreacao-gincana-bambole-criancas.webp', alt: 'Crianças correndo em gincana com bambolês' },
  { label: 'Campo de futebol', src: '/uploads/pimpao-festas-campo-de-futebol-infantil.webp', alt: 'Mini campo de futebol infantil com grama sintética' },
  { label: 'Pintura artística', src: '/uploads/pimpao-festas-camarim-pintura-artistica-menina.webp', alt: 'Menina recebendo pintura artística no rosto' },
  { label: 'Carrossel de carrinhos', src: '/uploads/pimpao-festas-salao-brinquedao-carrossel-de-carrinhos.webp', alt: 'Salão do Pimpão com brinquedão e carrossel de carrinhos' },
  { label: 'Mascote Pimpão', src: '/uploads/pimpao-festas-mascote-pimpao-abraco-crianca.webp', alt: 'Menina abraçando o mascote Pimpão' },
  { label: 'Playground', src: '/uploads/pimpao-festas-brinquedao-carrossel-cama-elastica.webp', alt: 'Playground com brinquedão, carrossel e cama elástica' },
  { label: 'Cama elástica', src: '/uploads/pimpao-festas-cama-elastica-big-jump-salao.webp', alt: 'Cama elástica Big Jump no salão decorado com balões' },
