  .ic-teal { background: #e9f5f2; color: #1d7567; }
  .ic-orange { background: #fdeee7; color: #c85f3c; }
  .ic-gold { background: #fdf3da; color: #a9802a; }

  /* ---- ESTRUTURA ---- */
  .estrutura-row { display: flex; gap: clamp(32px,5vw,60px); flex-wrap: wrap; align-items: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; background: #fff; border: 1px solid #ece3d5; font: 700 14px 'Nunito', sans-serif; color: #4a4450; }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .estrutura-grid { flex: 1 1 320px; min-width: 280px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ph { border-radius: 22px; display: grid; place-items: center; overflow: hidden; }
  .ph img, .mascote-ph img, .festa-img img, .gal-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph-teal { background: repeating-linear-gradient(135deg,#e9f5f2 0 18px,#dff0eb 18px 36px); }
  .ph-yellow { background: repeating-linear-gradient(135deg,#fdf3da 0 18px,#faecc8 18px 36px); }
  .ph-orange { background: repeating-linear-gradient(135deg,#fdeee7 0 18px,#fae0d4 18px 36px); }
  .ph-tag { font-family: ui-monospace, monospace; font-size: 12px; color: #9a8e7e; background: rgba(255,255,255,.8); padding: 6px 12px; border-radius: 999px; }
  .ph-teal .ph-tag { color: #56998c; }
  .ph-yellow .ph-tag { color: #b89545; }
  .ph-orange .ph-tag { color: #cd7a58; }

  /* ---- RECREAÇÃO ---- */
  .blob { position: absolute; border-radius: 50%; }
  .blob-1 { top: -40px; right: -30px; width: 200px; height: 200px; background: rgba(255,255,255,.06); }
  .blob-2 { bottom: -60px; left: -40px; width: 240px; height: 240px; background: rgba(255,255,255,.05); }
  .quote { font: 600 clamp(17px,1.8vw,21px)/1.5 'Nunito', sans-serif; color: #e2f3ef; margin: 0; font-style: italic; }
  .rec-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); gap: 18px; }
  .rec-card { background: rgba(255,255,255,.97); border-radius: 24px; padding: 26px 24px; }
  .rec-title { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 20px; color: #1d7567; margin: 0 0 14px; }
  .rec-item { display: flex; align-items: flex-start; gap: 10px; font: 600 15px/1.45 'Nunito', sans-serif; color: #4a4450; }
  .check { flex: none; margin-top: 1px; color: #ec7a55; font-weight: 800; }
  .mascote { display: flex; gap: clamp(24px,4vw,48px); flex-wrap: wrap; align-items: center; margin-top: 38px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); border-radius: 30px; padding: clamp(24px,3vw,36px); }
  .mascote-ph { aspect-ratio: 1; border-radius: 24px; overflow: hidden; background: repeating-linear-gradient(135deg,rgba(255,255,255,.22) 0 16px,rgba(255,255,255,.12) 16px 32px); display: grid; place-items: center; border: 3px solid rgba(255,255,255,.4); }
  .mascote-ph span { font-family: ui-monospace, monospace; font-size: 11px; color: #fff; text-align: center; padding: 0 8px; line-height: 1.5; }
  .mascote-title { font-family: 'Baloo 2', cursive; font-weight: 800; font-size: clamp(24px,3vw,34px); color: #fff; margin: 12px 0 10px; }
  .mascote-txt { font: 600 clamp(15px,1.6vw,17px)/1.55 'Nunito', sans-serif; color: #e2f3ef; margin: 0; }

  /* ---- FESTAS ---- */
  .festas-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap: 22px; }
  .festa-card { position: relative; background: #fdf8f1; border: 1px solid #f0e8db; border-radius: 26px; overflow: hidden; display: flex; flex-direction: column; transition: transform .18s, box-shadow .18s; }
  .festa-card:hover { transform: translateY(-6px); box-shadow: 0 24px 46px -24px rgba(0,0,0,.2); }
  .festa-img { aspect-ratio: 16/10; position: relative; display: grid; place-items: center; overflow: hidden; }
  .festa-img img { position: absolute; inset: 0; }
  .badge-pop { position: absolute; top: 14px; right: 14px; padding: 6px 13px; border-radius: 999px; background: #ec7a55; color: #fff; font: 800 11px/1 'Nunito', sans-serif; letter-spacing: .03em; text-transform: uppercase; }
  .festa-body { padding: 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .festa-tag { font: 800 12px/1 'Nunito', sans-serif; letter-spacing: .05em; text-transform: uppercase; }
  .festa-nome { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 24px; color: #3a3340; margin: 0; }
  .festa-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 6px; font: 800 15px 'Nunito', sans-serif; text-decoration: none; }
  .incluso-title { display: inline-block; font: 800 13px 'Nunito', sans-serif; color: #1d7567; text-transform: uppercase; letter-spacing: .06em; }
  .incluso-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 34px; margin-top: 26px; }
  .incluso-item { display: flex; flex-direction: column; align-items: center; gap: 12px; width: 128px; }
  .incluso-ic { width: 62px; height: 62px; border-radius: 50%; display: grid; place-items: center; }
  .incluso-txt { font: 700 14px/1.35 'Nunito', sans-serif; color: #3a3340; }
  .pagamento { margin: 32px auto 0; max-width: 680px; text-align: center; font: 500 15px/1.7 'Nunito', sans-serif; color: #8a8290; }

  /* ---- GALERIA ---- */
  .galeria-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(230px,1fr)); gap: 16px; }
  .gal-item { border: none; padding: 0; cursor: pointer; border-radius: 22px; overflow: hidden; aspect-ratio: 1; position: relative; display: grid; place-items: center; transition: transform .18s; }
  .gal-item:hover { transform: scale(1.02); }
  .gal-item .ph-tag { color: #8d8170; }
  .gal-zoom { position: absolute; bottom: 12px; right: 12px; width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.92); display: grid; place-items: center; color: #3a3340; font-size: 16px; box-shadow: 0 4px 10px rgba(0,0,0,.12); }

  /* ---- DEPOIMENTOS ---- */
  .stars { color: #f3c969; letter-spacing: 2px; display: inline-block; }
  .dep-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap: 22px; }
  .dep-card { background: #fdf8f1; border: 1px solid #f0e8db; border-radius: 24px; padding: 28px 26px; display: flex; flex-direction: column; }
  .dep-txt { font: 500 15px/1.65 'Nunito', sans-serif; color: #4a4450; margin: 0 0 20px; flex: 1; }
  .dep-av { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; font-family: 'Baloo 2', cursive; font-weight: 800; color: #fff; font-size: 18px; flex: none; }
  .dep-nome { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 16px; color: #3a3340; }
  .dep-festa { font: 600 13px 'Nunito', sans-serif; color: #8a8290; }

  /* ---- FAQ ---- */
  .faq-item { background: #fff; border: 1px solid #f0e8db; border-radius: 18px; overflow: hidden; }
  .faq-q { width: 100%; border: none; background: none; cursor: pointer; padding: 20px 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; text-align: left; font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 18px; color: #3a3340; }
  .faq-icon { flex: none; width: 30px; height: 30px; border-radius: 50%; background: #fdeee7; color: #ec7a55; display: grid; place-items: center; font-size: 20px; transition: transform .2s; }
  .faq-item.open .faq-icon { background: #ec7a55; color: #fff; transform: rotate(45deg); }
  .faq-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .25s ease; }
  .faq-item.open .faq-a { grid-template-rows: 1fr; }
  .faq-a-inner { overflow: hidden; }
  .faq-item.open .faq-a-inner { padding: 0 22px 22px; }
  .faq-a-inner { font: 500 15px/1.65 'Nunito', sans-serif; color: #6f6873; }

  /* ---- ORÇAMENTO ---- */
  .orc-wrap { max-width: 1080px; margin: 0 auto; display: flex; gap: clamp(32px,5vw,56px); flex-wrap: wrap; }
  .orc-wa { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; background: #e9f5f2; border-radius: 16px; padding: 16px 18px; }
  .orc-wa-ic { width: 42px; height: 42px; border-radius: 12px; background: #25D366; display: grid; place-items: center; flex: none; color: #fff; }
  .orc-loc { display: inline-flex; align-items: center; gap: 12px; background: #fdf8f1; border: 1px solid #f0e8db; border-radius: 16px; padding: 16px 18px; }
  .orc-loc-ic { width: 42px; height: 42px; border-radius: 12px; background: #fdeee7; display: grid; place-items: center; flex: none; color: #ec7a55; }
  .orc-form { background: #fdf8f1; border: 1px solid #f0e8db; border-radius: 26px; padding: clamp(24px,3vw,34px); }
  .orc-fields { display: grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap: 16px; }
  .lbl { display: block; font: 700 14px 'Nunito', sans-serif; color: #3a3340; margin-bottom: 6px; }
  .inp { width: 100%; padding: 14px 16px; border: 1.5px solid #ece3d5; border-radius: 14px; font: 500 16px 'Nunito', sans-serif; color: #3a3340; background: #fff; outline: none; transition: border-color .15s; }
  .inp:focus { border-color: #56a99b; }
  .btn-wa { grid-column: 1/-1; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 17px; border: none; border-radius: 999px; background: #25D366; color: #fff; font: 800 18px 'Nunito', sans-serif; cursor: pointer; box-shadow: 0 14px 28px -12px rgba(37,211,102,.6); transition: transform .15s; }
  .btn-wa:hover { transform: translateY(-2px); }

  /* ---- FOOTER ---- */
  .ft { background: #2e2733; color: #e8e2ee; padding: clamp(52px,7vw,80px) 24px 28px; }
  .ft-grid { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 36px; }
  .ft-logo { height: 54px; width: auto; display: block; margin-bottom: 16px; }
  .ft-about { font: 500 15px/1.6 'Nunito', sans-serif; color: #b8aec4; margin: 0 0 18px; max-width: 30ch; }
  .ft-soc { width: 42px; height: 42px; border-radius: 12px; background: rgba(255,255,255,.08); display: grid; place-items: center; color: #e8e2ee; transition: .15s; }
  .ft-soc-ig:hover { background: #ec7a55; }
  .ft-soc-wa:hover { background: #25D366; }
  .ft-h { font-family: 'Baloo 2', cursive; font-weight: 700; font-size: 17px; color: #fff; margin: 0 0 14px; }
  .ft-links { display: flex; flex-direction: column; gap: 10px; font: 600 15px 'Nunito', sans-serif; color: #c8bed4; }
  .ft-links a, .ft-links span { color: #c8bed4; text-decoration: none; }
  .ft-links a:hover { color: #fff; }
  .ft-map { border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.12); height: 150px; }
  .ft-map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(.2); }
  .ft-bottom { max-width: 1140px; margin: 34px auto 0; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.1); display: flex; flex-wrap: wrap; gap: 8px 18px; justify-content: space-between; font: 500 13px 'Nunito', sans-serif; color: #8d8398; }

  /* ---- LIGHTBOX ---- */
  .lb { position: fixed; inset: 0; z-index: 90; background: rgba(40,34,46,.86); backdrop-filter: blur(4px); display: grid; place-items: center; padding: 24px; }
  .lb[hidden] { display: none; }
  .lb-card-wrap { position: relative; width: min(620px,92vw); }
  .lb-card { position: relative; border-radius: 24px; overflow: hidden; display: grid; place-items: center; border: 4px solid #fff; background: #1f1a24; }
  .lb-card img { display: block; width: 100%; max-height: 82vh; object-fit: contain; }
  .lb-label { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); white-space: nowrap; font-family: ui-monospace, monospace; font-size: 14px; color: #fff; background: rgba(0,0,0,.45); padding: 8px 16px; border-radius: 999px; }
  .lb-close { position: absolute; top: -16px; right: -16px; width: 44px; height: 44px; border: none; border-radius: 50%; background: #fff; color: #3a3340; font-size: 22px; cursor: pointer; box-shadow: 0 6px 16px rgba(0,0,0,.3); }

  /* ---- WHATSAPP FAB ---- */
  .fab { position: fixed; bottom: 24px; right: 24px; z-index: 80; width: 60px; height: 60px; border-radius: 50%; background: #25D366; display: grid; place-items: center; color: #fff; box-shadow: 0 12px 28px -8px rgba(37,211,102,.7); animation: pulsate 2.4s infinite; transition: transform .15s; }
  .fab:hover { transform: scale(1.08); }
</style>

