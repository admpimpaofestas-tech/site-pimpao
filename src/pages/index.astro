<script>
  // Menu mobile (hambúrguer)
  const burger = document.querySelector('.hdr-burger');
  const menuNav = document.getElementById('menu-mobile');
  if (burger && menuNav) {
    const closeMenu = () => {
      menuNav.classList.remove('open');
      burger.classList.remove('open');
      burger.setAttribute('aria-expanded', 'false');
    };
    burger.addEventListener('click', () => {
      const isOpen = menuNav.classList.toggle('open');
      burger.classList.toggle('open', isOpen);
      burger.setAttribute('aria-expanded', String(isOpen));
    });
    menuNav.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  }

  // FAQ accordion
  document.querySelectorAll('.js-faq').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach((el) => el.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

  // Lightbox da galeria
  const lb = document.getElementById('lightbox');
  const lbCard = document.getElementById('lbCard');
  const lbLabel = document.getElementById('lbLabel');
  const lbImg = document.getElementById('lbImg');
  const openLb = (label, src, alt) => {
    lbLabel.textContent = label;
    lbImg.src = src;
    lbImg.alt = alt || label;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const closeLb = () => {
    lb.hidden = true;
    document.body.style.overflow = '';
  };
  document.querySelectorAll('.js-gal').forEach((b) => {
    b.addEventListener('click', () => openLb(b.dataset.label, b.dataset.src, b.dataset.alt));
  });
  lb.addEventListener('click', (e) => {
    if (e.target === lb || e.target.id === 'lbClose') closeLb();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lb.hidden) closeLb();
  });

  // Formulário -> WhatsApp
  const form = document.getElementById('orcForm');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const v = (k) => (fd.get(k) || '').toString().trim() || '-';
    const lines = [
      'Olá! Gostaria de solicitar um orçamento de festa no Pimpão.',
      '',
      'Nome: ' + v('nome'),
      'Telefone: ' + v('telefone'),
      'Data do evento: ' + v('data'),
      'Tipo de festa: ' + v('tipo'),
      'Nº de convidados: ' + v('convidados'),
      'Mensagem: ' + v('mensagem'),
    ];
    const waNum = form.dataset.wa;
    window.open('https://wa.me/' + waNum + '?text=' + encodeURIComponent(lines.join('\n')), '_blank');
  });
</script>

