---
import { waLink, waNum } from '../site.js';
---
<section id="orcamento" class="sec sec-white">
  <div class="orc-wrap">
    <div style="flex:1 1 320px;min-width:280px;">
      <span class="pill pill-teal">Solicite seu orçamento</span>
      <h2 class="h2 left">Fale com a Fê e a Mari!</h2>
      <p class="lead left" style="margin-bottom:26px;">Garanta a sua data agora e comece a sonhar com a festa perfeita. Preencha os dados e enviaremos tudo direto no seu WhatsApp.</p>
      <div style="display:flex;flex-direction:column;gap:14px;">
        <a href={waLink} target="_blank" rel="noopener" class="orc-wa">
          <span class="orc-wa-ic"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"></path></svg></span>
          <span><span style="display:block;font:700 13px 'Nunito',sans-serif;color:#1d7567;">WhatsApp</span><span style="display:block;font-family:'Baloo 2',cursive;font-weight:700;font-size:18px;color:#3a3340;">(51) 99135-5903</span></span>
        </a>
        <div class="orc-loc">
          <span class="orc-loc-ic"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg></span>
          <span><span style="display:block;font:700 13px 'Nunito',sans-serif;color:#c85f3c;">Onde estamos</span><span style="display:block;font:700 15px 'Nunito',sans-serif;color:#3a3340;">Av. Flores da Cunha, 713 · Cachoeirinha (Parada 49)</span></span>
        </div>
      </div>
    </div>
    <div style="flex:1 1 380px;min-width:300px;">
      <form id="orcForm" data-wa={waNum} class="orc-form">
        <div class="orc-fields">
          <div style="grid-column:1/-1;">
            <label class="lbl">Nome</label>
            <input name="nome" type="text" placeholder="Seu nome" class="inp" />
          </div>
          <div>
            <label class="lbl">Telefone</label>
            <input name="telefone" type="tel" placeholder="(51) 9 9999-9999" class="inp" />
          </div>
          <div>
            <label class="lbl">Data do evento</label>
            <input name="data" type="date" class="inp" />
          </div>
          <div>
            <label class="lbl">Tipo de festa</label>
            <select name="tipo" class="inp">
              <option value="">Selecione</option>
              <option value="Aniversário infantil">Aniversário infantil</option>
              <option value="Festa temática">Festa temática</option>
              <option value="Chá de bebê / revelação">Chá de bebê / revelação</option>
              <option value="Festa Brincante">Festa Brincante</option>
              <option value="Festa Clássica">Festa Clássica</option>
              <option value="Festa Exclusiva">Festa Exclusiva</option>
              <option value="Ainda não sei">Ainda não sei</option>
            </select>
          </div>
          <div>
            <label class="lbl">Nº de convidados</label>
            <input name="convidados" type="number" min="1" placeholder="Ex: 40" class="inp" />
          </div>
          <div style="grid-column:1/-1;">
            <label class="lbl">Mensagem</label>
            <textarea name="mensagem" rows="3" placeholder="Conte o tema, idade do aniversariante, o que imagina..." class="inp" style="resize:vertical;"></textarea>
          </div>
          <button type="submit" class="btn-wa"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"></path></svg>Enviar pelo WhatsApp</button>
          <p style="grid-column:1/-1;margin:0;text-align:center;font:500 13px 'Nunito',sans-serif;color:#9a9098;">Ao enviar, abriremos o WhatsApp com sua mensagem pronta. 💛</p>
        </div>
      </form>
    </div>
  </div>
</section>
