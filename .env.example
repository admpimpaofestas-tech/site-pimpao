PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
# URL do Worker (endpoint /event). Ex.: https://pimpao-tracking.SEUUSUARIO.workers.dev/event
PUBLIC_TRACK_ENDPOINT=
